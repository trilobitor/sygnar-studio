<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Codzienna kopia zapasowa katalogu danych.

  Podmień trzy znaczniki i skopiuj do ~/Library/LaunchAgents/ — polecenie
  sed jest w wdrozenie/README.md §5.
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>pl.sygnar.kopia</string>

  <key>ProgramArguments</key>
  <array>
    <string>__SCIEZKA_NODE__</string>
    <string>__SCIEZKA_PROJEKTU__/scripts/kopia.mts</string>
    <string>__KATALOG_KOPII__</string>
  </array>

  <key>WorkingDirectory</key>
  <string>__SCIEZKA_PROJEKTU__</string>

  <!-- Trzecia w nocy: maszyna zwykle stoi bezczynnie, a kopia trwa sekundy. -->
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key>
    <integer>3</integer>
    <key>Minute</key>
    <integer>0</integer>
  </dict>

  <!-- Gdy maszyna spała o trzeciej, kopia ma się zrobić po wybudzeniu. -->
  <key>RunAtLoad</key>
  <false/>

  <key>StandardOutPath</key>
  <string>__KATALOG_LOGOW__/kopia.log</string>
  <key>StandardErrorPath</key>
  <string>__KATALOG_LOGOW__/kopia.log</string>
</dict>
</plist>
