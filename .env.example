# Katalog danych: baza studio.db, katalogi zleceń, wgrane pliki i eksporty.
STUDIO_DATA_DIR=

# Katalog bin środowiska mflux — ten, w którym leży mflux-generate-flux2.
MFLUX_BIN_DIR=

FFMPEG_PATH=

# Puste dopuszczalne — darktable dotyczy dopiero etapu E6.
DARKTABLE_CLI_PATH=

# Puste dopuszczalne — bez klucza grafik wpisuje prompt po angielsku ręcznie.
ANTHROPIC_API_KEY=

# Zostaje na przyszłość. Backendem wersji 1 jest mflux (decyzja D5).
COMFY_URL=

MAX_CONCURRENT_GPU_JOBS=1
JOB_TIMEOUT_MS=900000

# Poziom logowania: debug | info | warn | error. Puste = info na produkcji.
LOG_LEVEL=

# Ścieżka do Claude Code. Puste = /opt/homebrew/bin/claude.
# Ta droga korzysta z subskrypcji i nie wymaga osobnego klucza API.
CLAUDE_CLI_PATH=

# Skąd bierzemy opis po angielsku: auto | cli | api | builder
PROMPT_BACKEND=auto

# Skrót hasła dostępu (scrypt). Wygeneruj: npm run haslo
# Puste = panel bez logowania. Dopuszczalne wyłącznie na localhost.
STUDIO_PASSWORD_HASH=

# Sekret podpisujący ciasteczko sesji, minimum 32 znaki.
# Wygeneruj: openssl rand -hex 32
STUDIO_SESSION_SECRET=

# Po ilu sekundach bezczynności panel sam się wylogowuje. Domyślnie 1800 (30 min).
AUTO_LOGOUT_SECONDS=

# Adresy pośredników, którym wolno ustawiać X-Forwarded-For (po przecinku).
# Puste = limity liczone po adresie gniazda. Nie wypełniaj „na zapas".
TRUSTED_PROXY_IPS=
STUDIO_OWNER_NAME=Kamil
# VIDEO_TIMEOUT_MS=
# EXPORT_TIMEOUT_MS=
# PHOTO_BATCH_TIMEOUT_MS=

# Katalog wyniku budowania. Domyślnie `.next`. Ustawiany tylko po to, żeby
# zbudować nową wersję obok działającego panelu i nie podmienić mu plików
# pod nogami — patrz komentarz w `next.config.ts`.
STUDIO_DIST_DIR=

# Generowanie wideo (Wan 2.2 TI2V-5B przez FastVideo/MLX).
#
# Katalog musi zawierać `venv/bin/python` oraz `wagi/FastMetal-5B-QAD`.
# Pusty wyłącza kafelek wideo — panel działa dalej, bez tego narzędzia.
FASTVIDEO_DIR=
# Limit czasu na klip. Domyślnie 900000 ms, czyli trzykrotność zmierzonych
# 310 s przy 720p i pięciu sekundach.
# VIDEO_GENERATE_TIMEOUT_MS=
