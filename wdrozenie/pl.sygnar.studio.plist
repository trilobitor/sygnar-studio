<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Usługa launchd dla panelu (SPEC §12, etap E7).

  Znaczniki do podmiany zapisane są jako __NAZWA__, nie w nawiasach kątowych —
  nawiasy czyniły z nich elementy XML i `plutil` odrzucał cały plik.

  Instalacja: patrz wdrozenie/README.md.
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>pl.sygnar.studio</string>

  <!--
    Uruchamiamy Node bezpośrednio, nie npm.
    Poprzednia wersja wskazywała /usr/local/bin/npm, którego na tej maszynie
    nie ma — npm leży w /opt/homebrew/bin. launchd nie przeszukuje PATH dla
    pierwszego elementu ProgramArguments, więc usługa padała natychmiast,
    a KeepAlive restartował ją w kółko.
  -->
  <key>ProgramArguments</key>
  <array>
    <string>__SCIEZKA_NODE__</string>
    <string>node_modules/next/dist/bin/next</string>
    <string>start</string>
  </array>

  <key>WorkingDirectory</key>
  <string>__SCIEZKA_PROJEKTU__</string>

  <key>EnvironmentVariables</key>
  <dict>
    <key>NODE_ENV</key>
    <string>production</string>
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
  </dict>

  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>

  <!-- Bez tego padająca usługa restartuje się co sekundę i zapycha log. -->
  <key>ThrottleInterval</key>
  <integer>30</integer>

  <key>StandardOutPath</key>
  <string>__KATALOG_LOGOW__/sygnar-studio.log</string>
  <key>StandardErrorPath</key>
  <string>__KATALOG_LOGOW__/sygnar-studio.error.log</string>
</dict>
</plist>
